# Admin credentials — never put the real password here.
# Generate a hash locally:
#   npm run admin:hash -- "your-strong-password"
# Then set HOLIKAR_ADMIN_PASSWORD_HASH to the printed value.

HOLIKAR_ADMIN_USER=
HOLIKAR_ADMIN_PASSWORD_HASH=
HOLIKAR_SESSION_SECRET=

# Required on Vercel so Open/Close is global across phones and servers.
# Create a free Upstash Redis (or Vercel KV) and paste:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
